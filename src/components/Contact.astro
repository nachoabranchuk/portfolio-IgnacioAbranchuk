---
const contactos = [
  {
    label: 'Email',
    texto: 'ignacioabranchuk@gmail.com',
    href: 'mailto:ignacioabranchuk@gmail.com',
    externo: false,
  },
  {
    label: 'GitHub',
    texto: 'github.com/nachoabranchuk',
    href: 'https://github.com/nachoabranchuk',
    externo: true,
  },
  {
    label: 'LinkedIn',
    texto: 'linkedin.com/in/nacho-abranchuk',
    href: 'https://www.linkedin.com/in/nacho-abranchuk-2715a1441',
    externo: true,
  },
];
---

<section id="contacto" class="scroll-mt-24 bg-slate-50 px-4 py-16 sm:py-24 dark:bg-slate-900">
  <div class="reveal mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Contacto</h2>
    <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
      Si querés charlar, proponerme algo o simplemente saludar, escribime por
      cualquiera de estos medios.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {contactos.map((c) => (
        <li>
            <a
                href={c.href}
                target={c.externo ? '_blank' : undefined}
                rel={c.externo ? 'noopener noreferrer' : undefined}
                class="block rounded-lg border border-slate-200 bg-white p-5 hover:border-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-blue-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 motion-safe:transition motion-safe:hover:-translate-y-1"
            >
                <span class="block font-semibold text-blue-700 dark:text-blue-400">{c.label}</span>
                <span class="mt-1 block break-words text-slate-800 dark:text-slate-100">{c.texto}</span>
                {c.externo && <span class="sr-only">(se abre en una pestaña nueva)</span>}
            </a>
        </li>
      ))}
    </ul>
  </div>
</section>