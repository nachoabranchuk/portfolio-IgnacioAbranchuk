---
const skills = [
  {
    category: 'Frontend',
    items: ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'React', 'Tailwind CSS', 'Astro'],
  },
  {
    category: 'Backend',
    items: ['Node.js', 'NestJS', 'MySQL', 'TypeORM', 'JWT'],
  },
  {
    category: 'Herramientas',
    items: ['Git', 'GitHub', 'VSCode'],
  },
];
---

<section id="sobre-mi" class="scroll-mt-24 bg-slate-50 px-4 py-16 sm:py-24 dark:bg-slate-900">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Sobre mí</h2>

    <p class="mt-6 max-w-2xl text-slate-700 dark:text-slate-300">
      Soy estudiante de Ingeniería en Sistemas en la Universidad Abierta
      Interamericana de Rosario. Me gusta entender cómo funcionan las cosas y
      construir sitios web que se vean y se sientan bien. Estoy aprendiendo todos
      los días y todavía explorando qué rama del desarrollo me gusta más.
    </p>

    <h3 class="mt-12 text-xl font-semibold text-slate-900 dark:text-white">Habilidades</h3>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {skills.map((group) => (
        <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
          <h4 class="font-semibold text-blue-700 dark:text-blue-400">{group.category}</h4>
          <ul class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-800 dark:bg-slate-700 dark:text-slate-100">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>