---
const projects = [
  {
    title: 'Futbolle',
    description:
      'Juego de adivinanza de futbolistas al estilo Wordle. Cada intento da pistas por colores y flechas (nacionalidad, club, posición, edad, overall y altura). Tiene tres niveles de dificultad, puntaje, historial de partidas, modo claro/oscuro y sonidos.',
    tech: ['HTML', 'CSS', 'JavaScript'],
    repo: 'https://github.com/nachoabranchuk/futbolle-proyecto',
    demo: 'https://nachoabranchuk.github.io/futbolle-proyecto/',
  },
  {
    title: 'Camiones App (Frontend)',
    description:
      'Aplicación web de gestión para Camiones App, con operaciones CRUD de módulos, formularios, acciones, grupos y usuarios, y control de acceso por roles. Desarrollada a partir de la estructura de un proyecto base de una compañera, adaptada a otro dominio.',
    tech: ['React', 'TypeScript', 'Vite', 'Tailwind CSS'],
    repo: 'https://github.com/nachoabranchuk/camiones-fe',
  },
  {
    title: 'Camiones App (Backend)',
    description:
      'API REST que sirve al frontend de Camiones App. Incluye autenticación con JWT, contraseñas encriptadas, validación de datos, base de datos MySQL con migraciones y envío de emails.',
    tech: ['NestJS', 'TypeScript', 'MySQL', 'TypeORM'],
    repo: 'https://github.com/nachoabranchuk/CamionesAppServer',
  },
];

const claseLink =
  'rounded text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600';
---

<section id="proyectos" class="scroll-mt-24 px-4 py-16 sm:py-24">
  <div class="reveal mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Proyectos</h2>

    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <li class="flex flex-col rounded-lg border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 motion-safe:transition motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-md">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{project.title}</h3>
          <p class="mt-3 text-slate-700 dark:text-slate-300">{project.description}</p>

          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tecnologías usadas">
            {project.tech.map((t) => (
              <li class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-800 dark:bg-slate-700 dark:text-slate-100">{t}</li>
            ))}
          </ul>

          <div class="mt-auto flex flex-wrap gap-4 pt-6 font-semibold">
            <a href={project.repo} target="_blank" rel="noopener noreferrer" class={claseLink}>
              Repositorio<span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
            </a>
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer" class={claseLink}>
                Demo<span class="sr-only"> de {project.title} (se abre en una pestaña nueva)</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>