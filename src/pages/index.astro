  <main>
    <section id="inicio" class="min-h-screen p-8">
      <h1 class="text-4xl font-bold">Hero (próximamente)</h1>
    </section>
    <section id="sobre-mi" class="min-h-screen p-8">
      <h2 class="text-3xl font-bold">Sobre mí</h2>
    </section>
    <section id="proyectos" class="min-h-screen p-8">
      <h2 class="text-3xl font-bold">Proyectos</h2>
    </section>
    <section id="contacto" class="min-h-screen p-8">
      <h2 class="text-3xl font-bold">Contacto</h2>
    </section>
  </main>
</Layout>