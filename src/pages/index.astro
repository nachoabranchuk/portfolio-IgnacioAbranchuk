---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Ignacio Abranchuk | Desarrollador Web">
  <Navbar />
  <main>
    <Hero />
    <section id="sobre-mi" class="min-h-screen scroll-mt-16 p-8">
      <h2 class="text-3xl font-bold">Sobre mí</h2>
    </section>
    <section id="proyectos" class="min-h-screen scroll-mt-16 p-8">
      <h2 class="text-3xl font-bold">Proyectos</h2>
    </section>
    <section id="contacto" class="min-h-screen scroll-mt-16 p-8">
      <h2 class="text-3xl font-bold">Contacto</h2>
    </section>
  </main>
</Layout>